{
  "name": "@entropretty/utils",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "description": "Utilities library for Entropretty",
  "license": "MIT",
  "keywords": [
    "entropretty",
    "typescript",
    "editor"
  ],
  "homepage": "https://github.com/peetzweg/entropretty-tools",
  "bugs": {
    "url": "https://github.com/peetzweg/entropretty-tools/issues"
  },
  "author": "peetzweg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peetzweg/entropretty-tools.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "watch": "tsup --watch",
    "build": "tsup && tsc --project tsconfig.lib.json --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "generate-prelude": "bun run generatePreludeString.ts",
    "test": "vitest",
    "lint": "tsc && eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@multiformats/blake2": "^2.0.3",
    "@noble/hashes": "^2.3.0",
    "p-queue": "^8.1.1",
    "prando": "^6.0.1"
  }
}
